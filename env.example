# Конфигурация для RAG-ассистента
# Скопируйте этот файл в .env и заполните значения

# API ключ OpenAI (обязательно!)
# Используется как для генерации ответов, так и для создания эмбеддингов
# Для обычного подключения получите ключ на https://platform.openai.com/api-keys
# Для ProxyAPI получите ключ на https://proxyapi.ru/
OPENAI_API_KEY=your_openai_api_key_here

# Пример для обычного подключения к OpenAI:
# OPENAI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1

# Пример для подключения через ProxyAPI:
# OPENAI_PROVIDER=proxyapi
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Выберите один вариант и раскомментируйте его
OPENAI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1

# Токен Telegram бота (опционально, для режима Telegram бота)
# Получите токен у @BotFather в Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Опционально: настройки модели для генерации ответов
# MODEL_NAME=gpt-3.5-turbo
# TEMPERATURE=0.7

# Опционально: настройки модели для эмбеддингов
# EMBEDDING_MODEL=text-embedding-3-small
# Альтернативы: text-embedding-3-large, text-embedding-ada-002

# Опционально: настройки векторной базы
# CHROMA_PERSIST_DIR=./chroma_db

# Опционально: настройки кеша
# CACHE_FILE=cache.json

# Опционально: настройки базы данных логов
# LOGS_DB_PATH=logs.db

